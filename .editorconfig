# 统一 ReqGuard 各文件类型的缩进、换行与字符集
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
indent_size = 2
# Markdown 的行尾两个空格表示换行，不要被编辑器自动清除
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{py}]
indent_size = 4
max_line_length = 100

[*.{ts,js}]
indent_size = 2
max_line_length = 100

[Makefile]
indent_style = tab
